rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 個人資料（coins, debt, persona...）— 只有本人可讀寫
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // 消費紀錄 subcollection — 只有本人可讀寫，無上限
      match /history/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // 美食地圖（food-map-app 共用本專案）— 每人一份，只有本人可讀寫
    match /foodmap/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 對戰房間 — 只有房主(creator)或房內玩家(players)可讀寫
    // 建房時會寫入 creator: request.auth.uid（見 useFirebaseSync.js）。
    match /rooms/{roomId} {
      allow read: if request.auth != null && (
        resource == null ||
        request.auth.uid == resource.data.creator ||
        request.auth.uid == resource.data.owner ||
        request.auth.uid in resource.data.players
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.creator ||
        request.auth.uid == resource.data.owner ||
        request.auth.uid in resource.data.players ||
        request.auth.uid in request.resource.data.players
      );
    }
  }
}
