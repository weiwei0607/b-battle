rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 個人資料（coins, debt, persona...）— 只有本人可讀寫
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // 消費紀錄 subcollection — 只有本人可讀寫，無上限
      match /history/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // 對戰房間 — 限制存取權限
    // ⚠️ 目前 app 在建立 room 時沒有寫入 creator / owner 欄位。
    // 建議未來在創建房間時一併寫入 creator: request.auth.uid，才能更精確地控制所有權。
    // 在沒有 creator/owner 的情況下，權限以 players map 以及 5 分鐘建立時間窗口為主進行判斷。
    match /rooms/{roomId} {
      allow read: if request.auth != null && (
        resource == null ||
        resource.data == null ||
        request.auth.uid in resource.data.players ||
        resource.data.players == null ||
        (resource.data.createdAt is int &&
         resource.data.createdAt <= request.time.seconds * 1000 + 60000 &&
         request.time.seconds * 1000 < resource.data.createdAt + 300000) ||
        request.auth.uid == resource.data.owner ||
        request.auth.uid == resource.data.creator
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.players ||
        request.auth.uid in request.resource.data.players ||
        request.auth.uid == resource.data.owner ||
        request.auth.uid == resource.data.creator
      );
    }
  }
}
